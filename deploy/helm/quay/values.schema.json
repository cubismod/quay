{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "imagePullSecrets",
    "config",
    "serviceAccount",
    "app",
    "workers",
    "migration",
    "ingress"
  ],
  "definitions": {
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "podLabels": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": [
            "app.kubernetes.io/name",
            "app.kubernetes.io/instance",
            "app.kubernetes.io/component"
          ]
        }
      },
      "additionalProperties": {"type": "string"}
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "openObject": {
      "type": "object",
      "additionalProperties": true
    },
    "openObjectArray": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": "string"},
        "digest": {"type": "string"},
        "pullPolicy": {"type": "string"}
      }
    },
    "imagePullSecrets": {"$ref": "#/definitions/imagePullSecrets"},
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {"type": "string"}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"},
        "annotations": {"$ref": "#/definitions/stringMap"},
        "imagePullSecrets": {"$ref": "#/definitions/imagePullSecrets"}
      }
    },
    "app": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 0},
        "entrypoint": {"type": "string", "const": "registry-nomigrate"},
        "minReadySeconds": {"type": "integer", "minimum": 0},
        "progressDeadlineSeconds": {"type": "integer", "minimum": 0},
        "revisionHistoryLimit": {"type": "integer", "minimum": 0},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "podAnnotations": {"$ref": "#/definitions/stringMap"},
        "podLabels": {"$ref": "#/definitions/podLabels"},
        "podSecurityContext": {"$ref": "#/definitions/openObject"},
        "tolerations": {"$ref": "#/definitions/openObjectArray"},
        "topologySpreadConstraints": {"$ref": "#/definitions/openObjectArray"},
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rollingUpdate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxUnavailable": {"type": "integer", "minimum": 0},
                "maxSurge": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            },
            "requests": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "timeoutSeconds": {"type": "integer", "minimum": 1},
            "periodSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "readinessProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "successThreshold": {"type": "integer", "minimum": 1},
            "initialDelaySeconds": {"type": "integer", "minimum": 0},
            "periodSeconds": {"type": "integer", "minimum": 1},
            "timeoutSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "livenessProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "periodSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "DEBUGLOG": {"type": "string"},
            "IGNORE_VALIDATION": {"type": "string"},
            "QUAY_LOGGING": {"type": "string"},
            "WORKER_CONNECTION_COUNT_REGISTRY": {"type": "string"},
            "DB_CONNECTION_POOLING": {"type": "string"},
            "WORKER_COUNT_WEB": {"type": "string"},
            "WORKER_COUNT_REGISTRY": {"type": "string"},
            "QUAY_SERVICES": {"type": "string"},
            "QUAY_OVERRIDE_SERVICES": {"type": "string"}
          }
        },
        "nodeSelector": {"$ref": "#/definitions/openObject"},
        "affinity": {"$ref": "#/definitions/openObject"},
        "services": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "https": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            }
          }
        }
      }
    },
    "workers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 0},
        "entrypoint": {"type": "string", "const": "registry-nomigrate"},
        "minReadySeconds": {"type": "integer", "minimum": 0},
        "progressDeadlineSeconds": {"type": "integer", "minimum": 0},
        "revisionHistoryLimit": {"type": "integer", "minimum": 0},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "podAnnotations": {"$ref": "#/definitions/stringMap"},
        "podLabels": {"$ref": "#/definitions/podLabels"},
        "podSecurityContext": {"$ref": "#/definitions/openObject"},
        "tolerations": {"$ref": "#/definitions/openObjectArray"},
        "topologySpreadConstraints": {"$ref": "#/definitions/openObjectArray"},
        "strategy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rollingUpdate": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "maxUnavailable": {"type": "integer", "minimum": 0},
                "maxSurge": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            },
            "requests": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "periodSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "readinessProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "successThreshold": {"type": "integer", "minimum": 1},
            "periodSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "livenessProbe": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "periodSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "DEBUGLOG": {"type": "string"},
            "IGNORE_VALIDATION": {"type": "string"},
            "QUAY_LOGGING": {"type": "string"},
            "DB_CONNECTION_POOLING": {"type": "string"},
            "QUAY_SERVICES": {"type": "string"},
            "QUAY_OVERRIDE_SERVICES": {"type": "string"}
          }
        },
        "nodeSelector": {"$ref": "#/definitions/openObject"},
        "affinity": {"$ref": "#/definitions/openObject"},
        "services": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "grpc": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            },
            "metrics": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"type": "string"},
        "targetRevision": {"type": "string", "minLength": 1},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            },
            "requests": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "DEBUGLOG": {"type": "string"}
          }
        },
        "nodeSelector": {"$ref": "#/definitions/openObject"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "host": {"type": "string"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^/"}
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "secretName": {"type": "string"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "app": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            },
            "required": ["app"]
          },
          {
            "properties": {
              "workers": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            },
            "required": ["workers"]
          },
          {
            "properties": {
              "migration": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            },
            "required": ["migration"]
          }
        ]
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "existingSecret": {"minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "serviceAccount": {
            "properties": {"create": {"const": false}},
            "required": ["create"]
          }
        },
        "required": ["serviceAccount"]
      },
      "then": {
        "properties": {
          "serviceAccount": {
            "properties": {"name": {"minLength": 1}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        },
        "required": ["ingress"]
      },
      "then": {
        "properties": {
          "app": {
            "properties": {
              "enabled": {"const": true},
              "services": {
                "properties": {
                  "https": {
                    "properties": {"enabled": {"const": true}}
                  }
                }
              }
            }
          },
          "ingress": {
            "properties": {
              "host": {"minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "tls": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            }
          }
        },
        "required": ["ingress"]
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "tls": {
                "properties": {"secretName": {"minLength": 1}}
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "migration": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        },
        "required": ["migration"]
      },
      "then": {
        "properties": {
          "app": {
            "properties": {"enabled": {"const": false}}
          },
          "workers": {
            "properties": {"enabled": {"const": false}}
          }
        }
      }
    }
  ]
}
