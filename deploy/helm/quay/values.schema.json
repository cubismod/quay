{
  "$schema": "https://json-schema.org/draft-07/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "config", "serviceAccount", "app", "workers", "migration", "ingress"],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": "string"},
        "digest": {"type": "string"},
        "pullPolicy": {"type": "string"}
      }
    },
    "config": {
      "type": "object",
      "properties": {
        "existingSecret": {"type": "string"}
      }
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string"}
      }
    },
    "app": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 0},
        "entrypoint": {"type": "string"},
        "minReadySeconds": {"type": "integer", "minimum": 0},
        "progressDeadlineSeconds": {"type": "integer", "minimum": 0},
        "revisionHistoryLimit": {"type": "integer", "minimum": 0},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "strategy": {
          "type": "object",
          "properties": {
            "rollingUpdate": {
              "type": "object",
              "properties": {
                "maxUnavailable": {"type": "integer", "minimum": 0},
                "maxSurge": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            },
            "requests": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "timeoutSeconds": {"type": "integer", "minimum": 1},
            "periodSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "readinessProbe": {
          "type": "object",
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "successThreshold": {"type": "integer", "minimum": 1},
            "initialDelaySeconds": {"type": "integer", "minimum": 0},
            "periodSeconds": {"type": "integer", "minimum": 1},
            "timeoutSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "livenessProbe": {
          "type": "object",
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "periodSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "DEBUGLOG": {"type": "string"},
            "IGNORE_VALIDATION": {"type": "string"},
            "QUAY_LOGGING": {"type": "string"},
            "WORKER_CONNECTION_COUNT_REGISTRY": {"type": "string"},
            "DB_CONNECTION_POOLING": {"type": "string"},
            "WORKER_COUNT_WEB": {"type": "string"},
            "WORKER_COUNT_REGISTRY": {"type": "string"},
            "QUAY_SERVICES": {"type": "string"},
            "QUAY_OVERRIDE_SERVICES": {"type": "string"}
          }
        },
        "nodeSelector": {"type": "object"},
        "affinity": {"type": "object"},
        "services": {
          "type": "object",
          "properties": {
            "https": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            },
            "metrics": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            }
          }
        }
      }
    },
    "workers": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 0},
        "entrypoint": {"type": "string"},
        "minReadySeconds": {"type": "integer", "minimum": 0},
        "progressDeadlineSeconds": {"type": "integer", "minimum": 0},
        "revisionHistoryLimit": {"type": "integer", "minimum": 0},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "strategy": {
          "type": "object",
          "properties": {
            "rollingUpdate": {
              "type": "object",
              "properties": {
                "maxUnavailable": {"type": "integer", "minimum": 0},
                "maxSurge": {"type": "integer", "minimum": 0}
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            },
            "requests": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            }
          }
        },
        "startupProbe": {
          "type": "object",
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "periodSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "readinessProbe": {
          "type": "object",
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "successThreshold": {"type": "integer", "minimum": 1},
            "periodSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "livenessProbe": {
          "type": "object",
          "properties": {
            "failureThreshold": {"type": "integer", "minimum": 1},
            "periodSeconds": {"type": "integer", "minimum": 1}
          }
        },
        "environment": {
          "type": "object",
          "properties": {
            "DEBUGLOG": {"type": "string"},
            "IGNORE_VALIDATION": {"type": "string"},
            "QUAY_LOGGING": {"type": "string"},
            "DB_CONNECTION_POOLING": {"type": "string"},
            "QUAY_SERVICES": {"type": "string"},
            "QUAY_OVERRIDE_SERVICES": {"type": "string"}
          }
        },
        "nodeSelector": {"type": "object"},
        "affinity": {"type": "object"},
        "services": {
          "type": "object",
          "properties": {
            "grpc": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            },
            "metrics": {
              "type": "object",
              "properties": {
                "enabled": {"type": "boolean"},
                "port": {"type": "integer", "minimum": 1, "maximum": 65535},
                "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
              }
            }
          }
        }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "targetRevision": {"type": "string", "minLength": 1},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 1},
        "backoffLimit": {"type": "integer", "minimum": 0},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "limits": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            },
            "requests": {
              "type": "object",
              "additionalProperties": {"type": ["string", "number"]}
            }
          }
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "DEBUGLOG": {"type": "string"}
          }
        },
        "nodeSelector": {"type": "object"}
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "className": {"type": "string"},
        "annotations": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "host": {"type": "string"},
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "pattern": "^/"}
        },
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {"type": "boolean"},
            "secretName": {"type": "string"}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "app": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            },
            "required": ["app"]
          },
          {
            "properties": {
              "workers": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            },
            "required": ["workers"]
          },
          {
            "properties": {
              "migration": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            },
            "required": ["migration"]
          }
        ]
      },
      "then": {
        "properties": {
          "config": {
            "properties": {
              "existingSecret": {"minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "serviceAccount": {
            "properties": {"create": {"const": false}},
            "required": ["create"]
          }
        },
        "required": ["serviceAccount"]
      },
      "then": {
        "properties": {
          "serviceAccount": {
            "properties": {"name": {"minLength": 1}}
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {"enabled": {"const": true}},
            "required": ["enabled"]
          }
        },
        "required": ["ingress"]
      },
      "then": {
        "properties": {
          "app": {
            "properties": {
              "enabled": {"const": true},
              "services": {
                "properties": {
                  "https": {
                    "properties": {"enabled": {"const": true}}
                  }
                }
              }
            }
          },
          "ingress": {
            "properties": {
              "host": {"minLength": 1}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "ingress": {
            "properties": {
              "tls": {
                "properties": {"enabled": {"const": true}},
                "required": ["enabled"]
              }
            }
          }
        },
        "required": ["ingress"]
      },
      "then": {
        "properties": {
          "ingress": {
            "properties": {
              "tls": {
                "properties": {"secretName": {"minLength": 1}}
              }
            }
          }
        }
      }
    }
  ]
}
